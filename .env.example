# Environment
NODE_ENV=development

# Server Port
PORT=3000

# PostgreSQL Configuration
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=postgresql://{POSTGRES_USER}:{POSTGRES_PASSWORD}@localhost:5432/{POSTGRES_DB}
# Use localhost when the API runs on your machine; inside Docker Compose the host is postgres.

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Security
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Quill <beth.t@example.com>

#---------------------------------------------------#

# Client URL (used for links in notification emails)
CLIENT_URL=http://localhost:5173

# Client API base URL
VITE_API_URL=http://localhost:3000/api

#---------------------------------------------------#
# Observability & Monitoring
#---------------------------------------------------#

# Sentry DSNs
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
VITE_SENTRY_DSN=

# Grafana Credentials (Docker Compose)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
