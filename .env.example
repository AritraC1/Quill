# Environment
NODE_ENV=development

# Server Port
PORT_NUMBER=3000

# PostgreSQL Configuration
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=postgresql://{POSTGRES_USER}:{POSTGRES_PASSWORD}@localhost:5432/{POSTGRES_DB}
# Use localhost when the API runs on your machine; inside Docker Compose the host is postgres.

# Security
JWT_SECRET=ci_test_secret_key_at_least_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Client URL
CLIENT_URL=http://localhost:5173